#!/bedrock/libexec/busybox sh
#
# brl-debian-updates
#
# Check enabled Debian strata for package updates.  Package installation is
# intentionally left to the user; this helper refreshes metadata, simulates an
# upgrade, and reports the exact commands needed to apply it.

set +eu
trap '' EXIT

[ "$(id -u)" -eq 0 ] || exit 0

strat="/bedrock/bin/strat"
brl="/bedrock/bin/brl"
state_dir="/bedrock/run/debian-updates-state"
log_dir="/bedrock/var/cache/brl-debian-updates"
interval=3600

mkdir -p "${state_dir}" "${log_dir}" /bedrock/run

# Only one checker may run.  The init hook is expected to start one instance,
# but the lock also protects against a manual invocation or a second boot job.
# Use mkdir rather than an optional `flock` applet so this works before the
# selected session stratum has populated PATH.
lock_dir="/bedrock/run/brl-debian-updates.lock"
if ! mkdir "${lock_dir}" 2>/dev/null; then
	old_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
	stale_lock=false
	if [ -n "${old_pid}" ]; then
		# A PID file lets us reclaim a lock left by a killed checker.
		if ! kill -0 "${old_pid}" 2>/dev/null; then
			stale_lock=true
		fi
	else
		# Do not reclaim an empty lock during the brief mkdir-to-PID window.
		lock_mtime="$(stat -c '%Y' "${lock_dir}" 2>/dev/null || echo 0)"
		now="$(date +%s 2>/dev/null || echo 0)"
		case "${lock_mtime}:${now}" in
		*[!0-9:]* | *:0) ;;
		*) [ "${now}" -ge "$((lock_mtime + 60))" ] && stale_lock=true ;;
		esac
	fi
	if "${stale_lock}"; then
		rm -rf "${lock_dir}"
		mkdir "${lock_dir}" 2>/dev/null || exit 0
	else
		exit 0
	fi
fi
printf '%s\n' "$$" >"${lock_dir}/pid"
trap 'rm -f "${lock_dir}/pid"; rmdir "${lock_dir}" 2>/dev/null || true' EXIT

notify() {
	message="${1}"
	printf '%s\n' "${message}" >>"/bedrock/run/debian-updates.notice"
	printf '%s\n' "${message}" >>"/bedrock/run/debian-updates.log"
	printf '%s\n' "${message}" >>"${log_dir}/notifications.log"

	# `wall` reaches logged-in terminals.  `logger` covers systemd/journald and
	# other syslog setups.  Both are optional on minimal strata.
	if command -v wall >/dev/null 2>&1; then
		printf '%s\n' "${message}" | wall 2>/dev/null || true
	fi
	if command -v logger >/dev/null 2>&1; then
		logger -t bedrock-debian-updates "${message}" 2>/dev/null || true
	fi
}

check_stratum() {
	stratum="${1}"
	os_release="$("${strat}" -r "${stratum}" cat /etc/os-release 2>/dev/null)" || return 0
	id="$(printf '%s\n' "${os_release}" | awk -F= '$1 == "ID" {gsub(/[\"]/, "", $2); print tolower($2); exit}')"
	[ "${id}" = "debian" ] || return 0

	# The apt executable must belong to this stratum.  Do not use the global
	# apt compatibility wrapper here, or another stratum could be updated.
	"${strat}" -r "${stratum}" apt-get --version >/dev/null 2>&1 || return 0

	update_log="${log_dir}/${stratum}.update.log"
	if ! DEBIAN_FRONTEND=noninteractive LC_ALL=C "${strat}" -r "${stratum}" apt-get \
		-o DPkg::Lock::Timeout=30 -o Acquire::Retries=2 -qq update >"${update_log}" 2>&1; then
		printf '%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ') ${stratum}: apt metadata update failed" \
			>>"/bedrock/run/debian-updates.log"
		return 0
	fi

	simulation="$(DEBIAN_FRONTEND=noninteractive LC_ALL=C "${strat}" -r "${stratum}" apt-get \
		-o DPkg::Lock::Timeout=30 -s -q upgrade 2>>"${update_log}")" || return 0
	pending="$(printf '%s\n' "${simulation}" | awk '$1 == "Inst" {print}')"
	state="${state_dir}/${stratum}.pending"

	if [ -z "${pending}" ]; then
		rm -f "${state}"
		return 0
	fi

	previous="$(cat "${state}" 2>/dev/null)"
	[ "${pending}" = "${previous}" ] && return 0

	printf '%s\n' "${pending}" >"${state}.new" && mv "${state}.new" "${state}"
	packages="$(printf '%s\n' "${pending}" | awk 'BEGIN {separator=""} {printf "%s%s", separator, $2; separator=" "} END {print ""}')"
	message="$(printf 'Debian updates available in stratum %s: %s\nRun: sudo apt update && sudo apt upgrade\n' "${stratum}" "${packages}")"
	notify "${message}"
}

check_all() {
	# Capture the enabled list once so stale state files can be removed after a
	# stratum is disabled or deleted.
	if ! enabled_strata="$("${brl}" list -ei 2>/dev/null)"; then
		# A transient brl failure must not erase valid pending state or notices.
		return 0
	fi
	# Stratum names cannot contain whitespace, so word splitting is intentional.
	# shellcheck disable=SC2086
	for stratum in ${enabled_strata}; do
		check_stratum "${stratum}"
	done

	for pending_state in "${state_dir}"/*.pending; do
		[ -f "${pending_state}" ] || continue
		pending_stratum="$(basename "${pending_state}" .pending)"
		if ! printf '%s\n' "${enabled_strata}" | grep -Fqx "${pending_stratum}"; then
			rm -f "${pending_state}"
		fi
	done

	# Remove a previously displayed notice once every Debian stratum is
	# up-to-date.  Keep it while any pending state remains so a later login can
	# still see an alert that was emitted before the desktop session started.
	for pending_state in "${state_dir}"/*.pending; do
		[ -f "${pending_state}" ] || continue
		return 0
	done
	rm -f /bedrock/run/debian-updates.notice
}

case "${1:---daemon}" in
--once)
	check_all
	;;
--daemon)
	# Check immediately at startup, then repeat hourly.  A failed network or
	# apt lock is retried on the next cycle without stopping the daemon.
	while :; do
		check_all
		sleep "${interval}"
	done
	;;
*)
	echo "Usage: brl-debian-updates [--once|--daemon]" >&2
	exit 2
	;;
esac
